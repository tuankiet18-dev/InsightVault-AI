POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=insightvault

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio-password

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

ASPNETCORE_ENVIRONMENT=Production
DATABASE_AUTO_MIGRATE=true
JWT_ISSUER=InsightVault.API
JWT_AUDIENCE=InsightVault.Frontend
JWT_SIGNING_KEY=change-me-jwt-signing-key-at-least-32-bytes
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Used by both backend Google token validation and frontend Google button.
# Add http://localhost:5173 to the OAuth client authorized JavaScript origins.

APP_DOMAIN=insightvault.duckdns.org
CADDY_ACME_EMAIL=your-email@example.com
HTTP_PORT=80
HTTPS_PORT=443
MINIO_HTTPS_PORT=9000
MINIO_CONSOLE_HTTPS_PORT=9001
VITE_API_BASE_URL=https://insightvault.duckdns.org/api
FRONTEND_ALLOWED_ORIGIN=https://insightvault.duckdns.org
FRONTEND_ALLOWED_ORIGIN_HTTPS=

MINIO_PUBLIC_ENDPOINT=insightvault.duckdns.org:9000
MINIO_BUCKET_NAME=insightvault-documents
# Controls HTTPS for browser-facing presigned URLs. Internal Docker traffic remains HTTP.
MINIO_USE_SSL=true
MINIO_CORS_ALLOW_ORIGIN=*

GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_CHAT_MODEL=models/gemini-2.5-flash
CHAT_PROVIDER=gemini
CHAT_TEMPERATURE=0.2
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
AI_ALLOW_REPORT_PERSISTENCE=false
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_BATCH_SIZE=20
RAG_TOP_K=5
RAG_DENSE_TOP_K=10
RAG_SPARSE_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.5
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=2.0

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_SENDER_NAME=InsightVault AI
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_USE_SSL=true

PAYOS_ENABLED=false
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=https://insightvault.duckdns.org/billing/success
PAYOS_CANCEL_URL=https://insightvault.duckdns.org/billing/cancel
PAYOS_CHECKOUT_EXPIRY_MINUTES=15
