POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=insightvault

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio-password

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

ASPNETCORE_ENVIRONMENT=Development
JWT_ISSUER=InsightVault.API
JWT_AUDIENCE=InsightVault.Frontend
JWT_SIGNING_KEY=change-me-jwt-signing-key-at-least-32-bytes
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

FRONTEND_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_ALLOWED_ORIGIN_HTTPS=https://localhost:5173

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_SENDER_NAME=InsightVault AI
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_USE_SSL=true

VNPAY_ENABLED=false
VNPAY_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_TMN_CODE=your-vnpay-sandbox-tmn-code
VNPAY_HASH_SECRET=your-vnpay-sandbox-hash-secret
VNPAY_RETURN_URL=http://localhost:5173/billing/return
