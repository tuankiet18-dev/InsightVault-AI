POSTGRES_USER=admin
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=insightvault

MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=change-me-minio-password

RABBITMQ_DEFAULT_USER=admin
RABBITMQ_DEFAULT_PASS=change-me-rabbitmq-password

ASPNETCORE_ENVIRONMENT=Development
JWT_ISSUER=InsightVault.API
JWT_AUDIENCE=InsightVault.Frontend
JWT_SIGNING_KEY=change-me-jwt-signing-key-at-least-32-bytes
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Used by both backend Google token validation and frontend Google button.
# Add http://localhost:5173 to the OAuth client authorized JavaScript origins.

FRONTEND_ALLOWED_ORIGIN=http://localhost:5173
FRONTEND_ALLOWED_ORIGIN_HTTPS=https://localhost:5173

SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_SENDER_NAME=InsightVault AI
SMTP_SENDER_EMAIL=your-email@gmail.com
SMTP_USE_SSL=true

PAYOS_ENABLED=false
PAYOS_CLIENT_ID=your-payos-client-id
PAYOS_API_KEY=your-payos-api-key
PAYOS_CHECKSUM_KEY=your-payos-checksum-key
PAYOS_RETURN_URL=http://localhost:5173/billing/success
PAYOS_CANCEL_URL=http://localhost:5173/billing/cancel
