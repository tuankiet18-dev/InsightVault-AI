# InsightVault AI service environment

# Gemini is always required for embeddings.
# Keep the embedding dimension at 768 unless you also migrate pgvector schema and re-embed documents.
GEMINI_API_KEY=your_gemini_api_key
GEMINI_EMBEDDING_MODEL=models/gemini-embedding-001
GEMINI_CHAT_MODEL=models/gemini-2.5-flash

# Chat/generation provider: gemini | groq
# - gemini: use GEMINI_CHAT_MODEL for RAG answers, summaries, compare, reports.
# - groq: use GROQ_CHAT_MODEL for generation while embeddings still use Gemini.
CHAT_PROVIDER=gemini
CHAT_TEMPERATURE=0.2

# Groq generation config. Required only when CHAT_PROVIDER=groq.
GROQ_API_KEY=your_groq_api_key
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# PostgreSQL connection string (PostgreSQL + pgvector).
# Target boundary: backend owns business-table writes; AI DB access is MVP/internal only.
DATABASE_URL=postgresql://admin:password123@localhost:5433/insightvault
AI_ALLOW_REPORT_PERSISTENCE=false

# MinIO. AI service reads files after backend has authorized and queued processing.
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=password123
MINIO_SECURE=false

# Document processing.
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_BATCH_SIZE=20

# Hybrid RAG retrieval.
# RAG_TOP_K is the final fused chunk count. Dense/sparse top-k are candidate pools.
RAG_TOP_K=5
RAG_DENSE_TOP_K=10
RAG_SPARSE_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.5

# Retry settings for Gemini embedding and generation provider calls.
GEMINI_MAX_RETRIES=3
GEMINI_RETRY_DELAY=2.0
