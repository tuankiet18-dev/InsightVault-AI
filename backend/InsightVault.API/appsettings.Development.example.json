{
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5433;Database=insightvault;Username=admin;Password=password123"
  },
  "Jwt": {
    "Issuer": "InsightVault.API",
    "Audience": "InsightVault.Frontend",
    "SigningKey": "development-only-signing-key-change-before-production-1234567890",
    "ExpiresMinutes": 120
  },
  "GoogleAuth": {
    "ClientId": "your-google-client-id.apps.googleusercontent.com"
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "https://localhost:5173",
      "http://localhost:3000",
      "https://localhost:3000"
    ]
  },
  "MinIO": {
    "Endpoint": "localhost:9000",
    "PublicEndpoint": "localhost:9000",
    "AccessKey": "admin",
    "SecretKey": "password123",
    "BucketName": "insightvault-documents",
    "PresignedUploadMinutes": 10,
    "UseSsl": false
  },
  "RabbitMQ": {
    "Host": "localhost",
    "Port": 5672,
    "Username": "admin",
    "Password": "password123",
    "DocumentProcessingQueue": "document-processing",
    "AiJobsQueue": "ai-jobs",
    "EmailQueue": "emails"
  },
  "AIService": {
    "BaseUrl": "http://localhost:8000"
  },
  "TrashCleanup": {
    "Enabled": true,
    "DocumentRetentionDays": 30,
    "IntervalHours": 24,
    "BatchSize": 50
  },
  "Smtp": {
    "Enabled": false,
    "Host": "smtp.gmail.com",
    "Port": 587,
    "Username": "your-email@gmail.com",
    "Password": "your-app-password",
    "SenderName": "InsightVault AI",
    "SenderEmail": "your-email@gmail.com",
    "UseSsl": true
  },
  "Billing": {
    "EnforceCredits": true,
    "DocumentCreditsPerFiveMb": 1,
    "GenerateReportBaseCredits": 5,
    "CompareBaseCredits": 5,
    "CompareAdditionalDocumentCredits": 2
  },
  "VnPay": {
    "Enabled": false,
    "PaymentUrl": "https://sandbox.vnpayment.vn/paymentv2/vpcpay.html",
    "TmnCode": "your-vnpay-sandbox-tmn-code",
    "HashSecret": "your-vnpay-sandbox-hash-secret",
    "ReturnUrl": "http://localhost:5173/billing/return",
    "CheckoutExpiryMinutes": 15
  },
  "AllowedHosts": "*",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
